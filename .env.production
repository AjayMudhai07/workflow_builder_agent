# =============================================================================
# IRA Workflow Builder - Production Environment Configuration (AWS EC2)
# =============================================================================
# This file contains production-ready settings for AWS EC2 deployment
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env on your EC2 instance
# 2. Replace all placeholder values with your actual credentials
# 3. Set CORS_ORIGINS to include your EC2 public IP
# 4. Ensure .env is in .gitignore and never committed

# -----------------------------------------------------------------------------
# LLM Provider Selection
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai

# Phase-Specific Providers (Hybrid Mode - Recommended for Production)
# OpenAI for planning (better reasoning), Groq for coding (faster execution)
PLANNER_PROVIDER=openai
CODER_PROVIDER=groq
INTENT_AGENT_PROVIDER=groq
INTENT_AGENT_MODEL=openai/gpt-oss-120b

# -----------------------------------------------------------------------------
# OpenAI Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-actual-openai-key-here
OPENAI_CHAT_MODEL_ID=gpt-4o
OPENAI_MODEL=gpt-4o
OPENAI_RESPONSES_MODEL_ID=gpt-4o
OPENAI_API_BASE_URL=https://api.openai.com/v1

# -----------------------------------------------------------------------------
# Groq Configuration (REQUIRED for Hybrid Mode)
# -----------------------------------------------------------------------------
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=gsk-your-actual-groq-key-here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
APP_NAME=IRA Workflow Builder
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# -----------------------------------------------------------------------------
# CORS Settings - CRITICAL FOR EC2 DEPLOYMENT
# -----------------------------------------------------------------------------
# OPTION 1: For testing/development on EC2 (allow all origins)
CORS_ORIGINS=["*"]

# OPTION 2: For production with specific IP (RECOMMENDED)
# Replace XX.XX.XX.XX with your EC2 public IP address
# CORS_ORIGINS=["http://XX.XX.XX.XX:3000", "http://XX.XX.XX.XX:8000"]

# OPTION 3: For production with custom domain
# CORS_ORIGINS=["https://yourdomain.com", "https://www.yourdomain.com"]

CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# -----------------------------------------------------------------------------
# Storage Configuration
# -----------------------------------------------------------------------------
DATA_DIR=./data
UPLOADS_DIR=./data/uploads
OUTPUTS_DIR=./data/outputs
TEMP_DIR=./data/temp

STORAGE_DIR=./storage
CHECKPOINTS_DIR=./storage/checkpoints
CONVERSATIONS_DIR=./storage/conversations
METADATA_DIR=./storage/metadata

LOGS_DIR=./logs

# -----------------------------------------------------------------------------
# Workflow Configuration
# -----------------------------------------------------------------------------
MAX_QUESTIONS=10
MAX_CODE_EXECUTION_TIME=120
MAX_FILE_SIZE_MB=100
ALLOWED_FILE_EXTENSIONS=[".csv", ".xlsx", ".xls"]

# -----------------------------------------------------------------------------
# Authentication & Security (CHANGE THESE IN PRODUCTION!)
# -----------------------------------------------------------------------------
SECRET_KEY=$(openssl rand -hex 32)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Admin credentials - CHANGE THESE!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here

# -----------------------------------------------------------------------------
# Observability & Monitoring
# -----------------------------------------------------------------------------
ENABLE_TRACING=false
PRETTY_PRINT_LOGS=false

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
FEATURE_CHECKPOINTING=true
FEATURE_CONVERSATION_HISTORY=true
FEATURE_CODE_SANDBOX=true
FEATURE_WORKFLOW_ANALYTICS=false

# -----------------------------------------------------------------------------
# Development Settings (DISABLED IN PRODUCTION)
# -----------------------------------------------------------------------------
RELOAD_ON_CHANGE=false
