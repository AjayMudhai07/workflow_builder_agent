# =============================================================================
# Frontend Environment Configuration - Production (AWS EC2)
# =============================================================================

# API Configuration
# Option 1: Let the frontend auto-detect the hostname (RECOMMENDED for EC2)
# Leave this commented out and the frontend will use window.location.hostname:8000
# NEXT_PUBLIC_API_URL=

# Option 2: Specify explicit API URL
# Uncomment and replace XX.XX.XX.XX with your EC2 public IP
# NEXT_PUBLIC_API_URL=http://XX.XX.XX.XX:8000

# Option 3: Use custom domain
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Application Configuration
NEXT_PUBLIC_APP_NAME=IRA Workflow Builder
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_ENV=production
